{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "alpha-coach-mcp",
      "version": "0.2.0",
      "title": "Alpha Coach MCP"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back to the caller. Useful to verify MCP connectivity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Text to echo back."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_athletes",
        "title": "Listar alunos",
        "description": "Lista os alunos (perfis) vinculados ao tenant do coach. Retorna id, nome, email e telefone.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "search": {
              "type": "string",
              "description": "Filtro opcional por nome ou email."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de resultados (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_workout",
        "title": "Consultar treino do aluno",
        "description": "Retorna os exercícios prescritos para um aluno. Filtre por dia da semana (segunda, terca, ...) se quiser apenas o treino do dia.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "dia_semana": {
              "type": "string",
              "enum": [
                "segunda",
                "terca",
                "quarta",
                "quinta",
                "sexta",
                "sabado",
                "domingo"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_diet",
        "title": "Consultar dieta do aluno",
        "description": "Retorna a dieta publicada do aluno com objetivo, kcal alvo, macros, refeições, horários e alimentos de cada refeição.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_progress",
        "title": "Consultar evolução do aluno",
        "description": "Retorna as métricas de evolução do aluno: check-ins (peso, BF%, medidas) e avaliações físicas recentes com composição corporal. Ideal para acompanhar cutting/bulking.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "checkin_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "Quantidade de check-ins recentes (padrão 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_anamnesis",
        "title": "Consultar anamnese do aluno",
        "description": "Retorna a anamnese completa do aluno: histórico de saúde, sono, estresse, alimentação, suplementos, treino e ergogênicos.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_athlete",
        "title": "Adicionar aluno",
        "description": "Cria um novo aluno no tenant do coach. Envia convite por e-mail com senha temporária para que o aluno complete o onboarding no app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "nome_completo": {
              "type": "string",
              "minLength": 2,
              "description": "Nome completo do aluno."
            },
            "email": {
              "type": "string",
              "description": "E-mail do aluno."
            },
            "telefone": {
              "type": "string"
            },
            "sexo": {
              "type": "string",
              "enum": [
                "masculino",
                "feminino"
              ]
            }
          },
          "required": [
            "nome_completo",
            "email"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
