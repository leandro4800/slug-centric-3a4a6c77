{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://iflgryuemsohurtdaawm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "alpha-coach-mcp",
      "version": "0.3.0",
      "title": "Alpha Coach MCP"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back to the caller. Useful to verify MCP connectivity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Text to echo back."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_athletes",
        "title": "Listar alunos",
        "description": "Lista os alunos (perfis) vinculados ao tenant do coach. Retorna id, nome, email e telefone.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "search": {
              "type": "string",
              "description": "Filtro opcional por nome ou email."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de resultados (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_workout",
        "title": "Consultar treino do aluno",
        "description": "Retorna os exercícios prescritos para um aluno. Filtre por dia da semana (segunda, terca, ...) se quiser apenas o treino do dia.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "dia_semana": {
              "type": "string",
              "enum": [
                "segunda",
                "terca",
                "quarta",
                "quinta",
                "sexta",
                "sabado",
                "domingo"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_diet",
        "title": "Consultar dieta do aluno",
        "description": "Retorna a dieta publicada do aluno com objetivo, kcal alvo, macros, refeições, horários e alimentos de cada refeição.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_progress",
        "title": "Consultar evolução do aluno",
        "description": "Retorna as métricas de evolução do aluno: check-ins (peso, BF%, medidas) e avaliações físicas recentes com composição corporal. Ideal para acompanhar cutting/bulking.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "checkin_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "Quantidade de check-ins recentes (padrão 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_athlete_anamnesis",
        "title": "Consultar anamnese do aluno",
        "description": "Retorna a anamnese completa do aluno: histórico de saúde, sono, estresse, alimentação, suplementos, treino e ergogênicos.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_athlete",
        "title": "Adicionar aluno",
        "description": "Cria um novo aluno no tenant do coach. Envia convite por e-mail com senha temporária para que o aluno complete o onboarding no app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via cabeçalho Authorization: Bearer."
            },
            "nome_completo": {
              "type": "string",
              "minLength": 2,
              "description": "Nome completo do aluno."
            },
            "email": {
              "type": "string",
              "description": "E-mail do aluno."
            },
            "telefone": {
              "type": "string"
            },
            "sexo": {
              "type": "string",
              "enum": [
                "masculino",
                "feminino"
              ]
            }
          },
          "required": [
            "nome_completo",
            "email"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "set_athlete_workout",
        "title": "Definir treino do dia",
        "description": "Substitui (sobrescreve) o treino de um dia da semana do aluno pela lista de exercícios enviada. Use replace=false para apenas acrescentar exercícios ao final do dia.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "dia_semana": {
              "type": "string",
              "enum": [
                "segunda",
                "terca",
                "quarta",
                "quinta",
                "sexta",
                "sabado",
                "domingo"
              ]
            },
            "replace": {
              "type": "boolean",
              "description": "Padrão true: apaga os exercícios existentes do dia antes de inserir."
            },
            "exercicios": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exercicio": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Nome do exercício."
                  },
                  "series": {
                    "type": "string",
                    "description": "Ex: \"4\"."
                  },
                  "repeticoes": {
                    "type": "string",
                    "description": "Ex: \"8-10\"."
                  },
                  "cadencia": {
                    "type": "string"
                  },
                  "observacao": {
                    "type": "string"
                  },
                  "detalhes_execucao": {
                    "type": "string"
                  },
                  "video_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "exercicio"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "description": "Lista de exercícios na ordem desejada."
            }
          },
          "required": [
            "dia_semana",
            "exercicios"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_workout_exercise",
        "title": "Editar exercício do treino",
        "description": "Edita um exercício já prescrito (séries, repetições, cadência, observação, nome ou vídeo). Identifique pelo exercise_id (retornado por get_athlete_workout) ou pelo nome do exercício + dia da semana.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via Authorization: Bearer."
            },
            "exercise_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID da linha em treinos_prescritos."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "dia_semana": {
              "type": "string",
              "enum": [
                "segunda",
                "terca",
                "quarta",
                "quinta",
                "sexta",
                "sabado",
                "domingo"
              ]
            },
            "exercicio_atual": {
              "type": "string",
              "description": "Nome (ou parte) do exercício a editar, quando não usar exercise_id."
            },
            "novo_exercicio": {
              "type": "string"
            },
            "series": {
              "type": "string"
            },
            "repeticoes": {
              "type": "string"
            },
            "cadencia": {
              "type": "string"
            },
            "observacao": {
              "type": "string"
            },
            "detalhes_execucao": {
              "type": "string"
            },
            "video_url": {
              "type": "string"
            },
            "ordem": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_workout_exercise",
        "title": "Remover exercício do treino",
        "description": "Remove exercícios prescritos do aluno. Use exercise_id para remover um específico, ou dia_semana (+ opcionalmente exercicio) para remover do dia.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via Authorization: Bearer."
            },
            "exercise_id": {
              "type": "string",
              "format": "uuid"
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "dia_semana": {
              "type": "string",
              "enum": [
                "segunda",
                "terca",
                "quarta",
                "quinta",
                "sexta",
                "sabado",
                "domingo"
              ]
            },
            "exercicio": {
              "type": "string",
              "description": "Nome (ou parte) do exercício a remover."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "set_athlete_diet",
        "title": "Montar dieta do aluno",
        "description": "Cria e publica uma nova dieta para o aluno, com objetivo, kcal alvo, macros e refeições (com horários e alimentos). Substitui a dieta anterior como a mais recente.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via Authorization: Bearer."
            },
            "athlete_id": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string"
            },
            "nome": {
              "type": "string"
            },
            "objetivo": {
              "type": "string",
              "description": "Ex: \"emagrecimento\", \"hipertrofia\"."
            },
            "kcal_alvo": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "macros_alvo": {
              "type": "object",
              "properties": {
                "proteina_g": {
                  "type": "number"
                },
                "carbo_g": {
                  "type": "number"
                },
                "gordura_g": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "observacoes_clinicas": {
              "type": "string"
            },
            "publicar": {
              "type": "boolean",
              "description": "Padrão true: já publica a dieta para o aluno."
            },
            "refeicoes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Ex: \"Café da manhã\"."
                  },
                  "horario": {
                    "type": "string",
                    "description": "Formato HH:MM, ex: \"07:30\"."
                  },
                  "descricao_ia": {
                    "type": "string",
                    "description": "Descrição livre da refeição."
                  },
                  "itens": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "alimento": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Nome do alimento (busca na base TACO; se não achar, entra como texto na descrição)."
                        },
                        "quantidade_g": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "substituicoes": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "alimento"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "nome"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "refeicoes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_exercise_library",
        "title": "Listar biblioteca de exercícios e vídeos técnicos",
        "description": "Lista os exercícios e vídeos técnicos disponíveis para o coach (tabelas referencia_exercicios, referencia_videos e biblioteca_exercicios), incluindo vídeos globais do app. Use antes de montar treino para escolher exercícios com vídeo já cadastrado.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mcp_token": {
              "type": "string",
              "description": "Token MCP do coach. Opcional se enviado via Authorization: Bearer."
            },
            "search": {
              "type": "string",
              "description": "Filtro por nome do exercício."
            },
            "grupo_muscular": {
              "type": "string",
              "description": "Filtro por grupamento muscular."
            },
            "apenas_meus": {
              "type": "boolean",
              "description": "Padrão false: inclui também os vídeos globais do app."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "description": "Máximo por tabela (padrão 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
